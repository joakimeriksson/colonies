# Copy to demo.env and fill in. Server connection comes from the usual COLONIES_* variables.
export TZ=Europe/Stockholm
export COLONIES_SERVER_HOST=localhost
export COLONIES_SERVER_PORT=50080
export COLONIES_TLS=false
export COLONIES_COLONY_NAME=dev
export COLONIES_COLONY_PRVKEY=<colony private key>
# One private key per user (colonies security generate), registered with colonies user add
export ALICE_KEY=<key>
export BOB_KEY=<key>
export CAROL_KEY=<key>
# One private key per fake executor, registered with colonies executor add --owner <user> --approve
export ABOX_KEY=<key>
export BGPU_KEY=<key>
